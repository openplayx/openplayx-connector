# Reference copy of the unit written by `openplayx-home install` (default paths).
[Unit]
Description=OpenPlayX home (manager + embedded sing-box + frpc)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openplayx-home
Group=openplayx-home
ExecStart=/opt/openplayx-home/current/openplayx-home serve --config-dir /var/lib/openplayx-home
Restart=on-failure
RestartSec=5
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/openplayx-home
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
